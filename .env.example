# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored. Never commit real keys.
# ---------------------------------------------------------------------------

# Supabase -> Project Settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (server only). The app itself does not need it:
# everything goes through Row Level Security with the anon key + user session.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mailgun -> Sending -> API keys
# MAILGUN_DOMAIN is the sending domain, NOT the login domain:
#   login  -> login.mailgun.com
#   sending-> mg.example.com
MAILGUN_API_KEY=key-0000000000000000000000000000000
MAILGUN_DOMAIN=mg.example.com
MAILGUN_FROM=Example Shop <no-reply@mg.example.com>

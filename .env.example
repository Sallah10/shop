# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored. Never commit real keys.
# ---------------------------------------------------------------------------

# Supabase -> Project Settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# There is deliberately no service role key here. Admin writes go out with the
# anon key and are authorised by Row Level Security against supabase/admin.sql,
# so the database is the security boundary.

# Mailgun -> Sending -> API keys
# MAILGUN_DOMAIN is the sending domain, NOT the login domain:
#   login  -> login.mailgun.com
#   sending-> mg.example.com
MAILGUN_API_KEY=key-0000000000000000000000000000000
MAILGUN_DOMAIN=mg.example.com
MAILGUN_FROM=Example Shop <no-reply@mg.example.com>

# Public URL of the deployed site, used for canonical links, sitemap.xml,
# robots.txt and structured data. No NEXT_PUBLIC_ prefix: it is only read on
# the server. On Vercel it is filled in automatically, locally use
# http://localhost:3000
SITE_URL=http://localhost:3000
